---
import Base from '../../layouts/Base.astro';
import ContentBlock from '../../components/ContentBlock.astro';
import CallToAction from '../../components/CallToAction.astro';
import StatGrid from '../../components/StatGrid.astro';
import IsoArchitecture from '../../components/IsoArchitecture.astro';
import LineChart from '../../components/LineChart.astro';
import SmallMultiples from '../../components/SmallMultiples.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Arrow from '../../components/Arrow.astro';
import { localProducts } from '../../data/site';
import { getSection } from '../../lib/content';
import { t } from '../../lib/copy';
import EmailLink from '../../components/EmailLink.astro';

export function getStaticPaths() {
  return localProducts.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

const { product } = Astro.props;

const name = t(`${product.key}.name`);
const tagline = t(`${product.key}.description`);
const isDSQL = product.slug === 'd-sql';

// D-SQL is the only product with a full detail tree in the dictionaries;
// the others carry the sections lifted out of the old pages.
const detailPath = product.detailKey ?? `${product.key}.detail`;
const blockKeys = isDSQL
  ? ['keyFeatures', 'oltpOlap', 'eventQueue', 'streaming', 'deployment', 'targetAudience']
  : ['coreFeatures', 'servicesSection', 'benefits', 'useCases', 'technical', 'deployment', 'whyChoose'];

const blocks = blockKeys
  .map((key) => ({ key, section: getSection(`${detailPath}.${key}`) }))
  .filter((b) => b.section && (b.section.items.length > 0 || b.section.title));

const subtitle = isDSQL ? t('netterDSQL.subtitle') : tagline;

const site = 'https://www.netter.io';
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name,
    description: subtitle,
    brand: { '@type': 'Brand', name: 'Netter' },
    category: 'Software',
    url: `${site}/products/${product.slug}/`,
    ...(product.status ? { releaseDate: undefined } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site}/` },
      { '@type': 'ListItem', position: 2, name: 'Products', item: `${site}/products/` },
      { '@type': 'ListItem', position: 3, name, item: `${site}/products/${product.slug}/` },
    ],
  },
];

const stats = isDSQL
  ? [
      { value: '99.99%', label: t('netterDSQL.performanceStats.availability') },
      { value: '∞', label: t('netterDSQL.performanceStats.scalability') },
      { value: 'ACID', label: t('netterDSQL.performanceStats.transactions') },
      { value: '3-in-1', label: t('netterDSQL.performanceStats.workloads') },
    ]
  : [];
---
<Base title={name} description={subtitle} schema={schema}>
  <Breadcrumb
   
    trail={[
      { label: t('header.products'), href: '/products' },
      { label: name },
    ]}
  />

  <section class="section blueprint">
    <div class="shell prod-hero">
      <div class="prod-hero__marks rise">
        <span class="badge badge--accent">{tagline}</span>
        {product.status && <span class="plate">{product.status}</span>}
      </div>
      <h1 class="display-lg rise" style="animation-delay:.12s">{name}</h1>
      <p class="lead prod-hero__lead rise" style="animation-delay:.24s">{subtitle}</p>
      <div class="prod-hero__actions rise" style="animation-delay:.34s">
        <EmailLink label={t('common.contactSales')} class="btn btn--primary"><Arrow /></EmailLink>
        <EmailLink label={t('common.learnMore')} class="btn btn--ghost"></EmailLink>
      </div>
    </div>
  </section>

  {stats.length > 0 && (
    <section class="stat-bar">
      <div class="shell"><StatGrid stats={stats} bare /></div>
    </section>
  )}

  {isDSQL && (
    <section class="section section--alt">
      <div class="shell">
        <header class="arch-head" data-reveal>
          <div class="eyebrow">Architecture</div>
          <h2 class="h2">Three engines. One storage layer.</h2>
          <p class="lead">{t('netterDSQL.subtitle')}</p>
        </header>
        <div data-reveal>
          <IsoArchitecture
            engines={[
              { name: 'OLTP', sub: 'ACID · row store' },
              { name: 'OLAP', sub: 'MPP · columnar' },
              { name: 'Streaming', sub: 'event queue · CDC' },
            ]}
            storageLabel="Unified distributed storage"
            storageSub="row + columnar · replicated · rebalancing online"
            caption="Transactional, analytical and streaming engines over one storage layer"
          />
        </div>
      </div>
    </section>
  )}

  {blocks.map((b, i) => (
    <ContentBlock
      section={b.section!}
      eyebrow={i === 0 ? name : undefined}
      cols={3}
      alt={i % 2 === 1}
    />
  ))}

  {isDSQL && (
    <section class="section section--alt">
      <div class="shell">
        <header class="sec-head" data-reveal>
          <div class="sec-head__copy">
            <div class="eyebrow">Performance</div>
            <h2 class="h2">{t('netterDSQL.performanceStats.title')}</h2>
          </div>
          <p class="sample-flag mono">Sample data — replace with benchmarks</p>
        </header>

        <div data-reveal>
          <LineChart
            values={[11.2, 11.0, 10.6, 10.4, 10.1, 9.9, 9.8, 9.7]}
            labels={['8', '12', '16', '24', '32', '40', '52', '64']}
            title="p99 write latency as the cluster grows"
            unit="Milliseconds, 3-replica quorum writes"
            headline="9.7"
            headlineUnit="ms @ 64 nodes"
            axisLabel="Cluster size — nodes"
          />
        </div>

        <div class="facets" data-reveal>
          <SmallMultiples
            facets={[
              { name: 'OLTP', unit: 'txn/sec, thousands', peak: '412K', values: [12, 68, 150, 236, 305, 358, 392, 412] },
              { name: 'OLAP', unit: 'scan GB/sec', peak: '86', values: [4, 19, 38, 55, 67, 76, 82, 86] },
              { name: 'Streaming', unit: 'events/sec, millions', peak: '2.4M', values: [0.2, 0.7, 1.2, 1.6, 1.9, 2.1, 2.3, 2.4] },
            ]}
            axisFrom="0"
            axisTo="10K"
            axisLabel="Concurrent clients"
          />
        </div>
      </div>
    </section>
  )}

  <CallToAction
    title={`${name} — ${t('about.cta.heading')}`}
    description={t('about.cta.description')}
    primary={{ label: t('common.contactSales') }}
    secondary={{ label: t('header.products'), href: '/products' }}
  />
</Base>

<style>
  .prod-hero { display: flex; flex-direction: column; gap: 28px; max-width: 900px; }
  .prod-hero__marks { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .prod-hero__lead { max-width: 720px; font-size: clamp(16px, 1.5vw, 20px); }
  .prod-hero__actions { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }

  .stat-bar { border-bottom: 1px solid var(--hairline); }

  .arch-head { display: flex; flex-direction: column; gap: 14px; max-width: 720px; margin-bottom: 32px; }

  .sec-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 28px; flex-wrap: wrap; margin-bottom: 44px; }
  .sec-head__copy { display: flex; flex-direction: column; gap: 14px; max-width: 620px; }

  .sample-flag {
    padding: 7px 12px;
    border: 1px solid var(--accent-edge);
    background: var(--accent-wash);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .facets { margin-top: 1px; }

  @media (max-width: 700px) { .prod-hero__actions :global(.btn) { width: 100%; } }
</style>
