---
import Base from '../layouts/Base.astro';
import IsoStack from '../components/IsoStack.astro';
import CallToAction from '../components/CallToAction.astro';
import StatGrid from '../components/StatGrid.astro';
import Arrow from '../components/Arrow.astro';
import Icon from '../components/Icon.astro';
import { products, services, splitStat, productHref } from '../data/site';
import { t } from '../lib/copy';
import EmailLink from '../components/EmailLink.astro';


const stats = ['companiesServed', 'uptime', 'projectsDelivered', 'support'].map((k) =>
  splitStat(t(`about.achievements.${k}`)),
);

const consultancyPoints = ['architecture', 'systemEngineering', 'technologyStrategy'].map((k) =>
  t(`home.consultancy.features.${k}`),
);
const productPoints = ['distributedSystems', 'cloudNative', 'microservices'].map((k) =>
  t(`home.products.features.${k}`),
);
---
<Base title="Netter" description={t('home.subtitle')}>
  <!-- ============================ HERO ============================ -->
  <section class="section blueprint hero">
    <div class="shell hero__inner">
      <div class="hero__copy">
        <div class="badge rise">{t('home.badge')}</div>
        <h1 class="display-xl rise" style="animation-delay:.16s">
          {t('home.title')}<br />
          <span class="subdued">{t('home.titleHighlight')}</span>
        </h1>
        <p class="lead hero__lead rise" style="animation-delay:.28s">{t('home.subtitle')}</p>
        <div class="hero__actions rise" style="animation-delay:.4s">
          <a href={'/products'} class="btn btn--primary">
            {t('home.products.cta')}<Arrow />
          </a>
          <EmailLink label={t('common.scheduleConsultation')} class="btn btn--ghost"></EmailLink>
        </div>
      </div>
      <div class="hero__figure">
        <IsoStack
          layers={[t('header.products'), 'Platform', 'Infrastructure']}
          nodes={products.map((p) => t(`${p.key}.name`))}
        />
      </div>
    </div>
  </section>

  <!-- ========================== PRODUCTS ========================== -->
  <section class="section">
    <div class="shell">
      <header class="sec-head" data-reveal>
        <div class="sec-head__copy">
          <div class="eyebrow">{t('header.products')}</div>
          <h2 class="h2">{t('home.products.title')}</h2>
          <p class="lead">{t('home.products.description')}</p>
        </div>
        <a href={'/products'} class="btn-text sec-head__more">
          {t('common.viewDetails')}<Arrow size={12} weight={2.4} />
        </a>
      </header>

      <div class="grid-rule cols-5" data-reveal>
        {products.map((p, i) => (
          <a
            href={productHref(p, (path) => path)}
            target={p.url ? '_blank' : undefined}
            rel={p.url ? 'noopener' : undefined}
            class="tile p-tile"
          >
            <div class="p-tile__top">
              <svg width="52" height="42" viewBox="0 0 52 42" fill="none" aria-hidden="true">
                <polygon points="26,4 47,14.5 26,25 5,14.5" fill="#1e1e26" stroke="#e3000f" stroke-width="1.2" />
                <polygon points="5,14.5 26,25 26,38 5,27.5" fill="#121218" stroke="#3a1015" stroke-width="1" />
                <polygon points="26,25 47,14.5 47,27.5 26,38" fill="#0e0e13" stroke="#3a1015" stroke-width="1" />
              </svg>
              {p.status
                ? <span class="plate">{p.status}</span>
                : <span class="p-tile__idx mono">{String(i + 1).padStart(2, '0')}</span>}
            </div>
            <div class="p-tile__body">
              <h3 class="h3">{t(`${p.key}.name`)}</h3>
              <p class="body-muted">{t(`${p.key}.description`)}</p>
            </div>
            <span class="btn-text">
              {p.url ? p.url.replace('https://', '') : t('common.learnMore')}
              <Arrow size={12} weight={2.4} />
            </span>
          </a>
        ))}
      </div>

      <ul class="points" data-reveal>
        {productPoints.map((point) => (
          <li><span class="points__marker" aria-hidden="true"></span>{point}</li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ========================== SERVICES ========================== -->
  <section class="section section--alt">
    <div class="shell services">
      <div class="services__intro" data-reveal>
        <div class="eyebrow">{t('header.services')}</div>
        <h2 class="h2">{t('home.consultancy.title')}</h2>
        <p class="lead">{t('home.consultancy.description')}</p>
        <ul class="points">
          {consultancyPoints.map((point) => (
            <li><span class="points__marker" aria-hidden="true"></span>{point}</li>
          ))}
        </ul>
        <a href={'/services'} class="btn btn--ghost services__cta">
          {t('home.consultancy.cta')}<Arrow size={14} />
        </a>
      </div>

      <div class="grid-rule cols-2 services__grid" data-reveal>
        {services.map((s) => (
          <a href={`/services/${s.slug}`} class="s-row">
            <span class="s-row__icon"><Icon path={s.icon} size={15} /></span>
            <span class="s-row__body">
              <span class="s-row__name">{t(`${s.key}.name`)}</span>
              <span class="s-row__desc">{t(`${s.key}.description`)}</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================ PROOF =========================== -->
  <section class="section">
    <div class="shell">
      <header class="sec-head sec-head--top" data-reveal>
        <div class="sec-head__copy">
          <h2 class="h2">{t('about.achievements.heading')}</h2>
          <p class="lead">{t('about.achievements.subtitle')}</p>
        </div>
        <p class="mono sec-head__note">NETTER S.R.L. — ASSISI, ITALY</p>
      </header>
      <StatGrid stats={stats} />
    </div>
  </section>


  <CallToAction
    title={t('about.cta.heading')}
    description={t('about.cta.description')}
    primary={{ label: t('about.cta.primaryButton') }}
    secondary={{ label: t('home.products.cta'), href: '/products' }}
  />
</Base>

<style>
  .hero { border-bottom: 1px solid var(--hairline); }
  .hero__inner { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 56px; align-items: center; }
  .hero__copy { display: flex; flex-direction: column; gap: 30px; }
  .hero__lead { max-width: 470px; }
  .hero__actions { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }

  .sec-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 32px; flex-wrap: wrap; margin-bottom: 52px; }
  /* With a subtitle present the note has to hang off the top, not the baseline. */
  .sec-head--top { align-items: flex-start; }
  .sec-head--top .sec-head__note { padding-top: 10px; }
  .sec-head__copy { display: flex; flex-direction: column; gap: 18px; max-width: 560px; }
  .sec-head__solo { max-width: 460px; }
  .sec-head__note { font-size: 11px; letter-spacing: 0.1em; color: var(--ink-faint); }
  .sec-head__more { padding-bottom: 8px; }

  .p-tile { min-height: 268px; }
  .p-tile .btn-text { word-break: break-all; }
  .p-tile__top { display: flex; align-items: flex-start; justify-content: space-between; }
  .p-tile__idx { font-size: 11px; letter-spacing: 0.1em; color: var(--ink-ghost); }
  .p-tile__body { display: flex; flex-direction: column; gap: 10px; flex-grow: 1; }

  .points { list-style: none; display: flex; flex-wrap: wrap; gap: 14px 36px; margin: 26px 0 0; padding: 0; }
  .points li { display: flex; align-items: center; gap: 10px; font-size: 14px; color: var(--ink-muted); }
  .points__marker { width: 5px; height: 5px; background: var(--accent); flex-shrink: 0; }

  .services { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 56px; align-items: start; }
  .services__intro { display: flex; flex-direction: column; gap: 20px; position: sticky; top: calc(var(--header-h) + 24px); }
  .services__intro .points { flex-direction: column; gap: 12px; margin-top: 4px; }
  .services__cta { align-self: flex-start; margin-top: 8px; }
  .services__grid { grid-column: span 2; }

  .s-row { display: flex; align-items: flex-start; gap: 16px; padding: 24px; min-height: 96px; border-top: 2px solid transparent; transition: border-color 0.25s ease; }
  .s-row:hover { border-top-color: var(--accent); color: var(--ink); }
  .s-row__icon { display: flex; align-items: center; justify-content: center; width: 30px; height: 30px; flex-shrink: 0; border: 1px solid var(--hairline); color: var(--accent); }
  .s-row__body { display: flex; flex-direction: column; gap: 5px; }
  .s-row__name { font-size: 15px; font-weight: 600; letter-spacing: -0.005em; }
  .s-row:hover .s-row__name { color: var(--accent); }
  .s-row__desc { font-size: 13px; line-height: 1.5; color: var(--ink-dim); }


  @media (max-width: 1000px) {
    .hero__inner { grid-template-columns: minmax(0, 1fr); gap: 40px; }
    .services { grid-template-columns: minmax(0, 1fr); gap: 32px; }
    .services__grid { grid-column: auto; }
    .services__intro { position: static; }
  }
  @media (max-width: 700px) {
    .hero__actions :global(.btn) { width: 100%; }
    .sec-head { margin-bottom: 32px; }
  }
</style>
