---
import Base from '../../../layouts/Base.astro';
import ContentBlock from '../../../components/ContentBlock.astro';
import CallToAction from '../../../components/CallToAction.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import Icon from '../../../components/Icon.astro';
import Arrow from '../../../components/Arrow.astro';
import { services } from '../../../data/site';
import { getSection } from '../../../lib/content';
import { useTranslations, localizePath, locales, defaultLocale } from '../../../i18n/ui';

export function getStaticPaths() {
  return locales.flatMap((locale) =>
    services.map((service) => ({
      params: { locale: locale === defaultLocale ? undefined : locale, slug: service.slug },
      props: { locale, service },
    })),
  );
}

const { locale, service } = Astro.props;
const t = useTranslations(locale);
const lp = (p: string) => localizePath(p, locale);

const name = t(`${service.key}.name`);
const title = t(`${service.key}.title`);
const subtitle = t(`${service.key}.subtitle`);

/* Every service shares badge/title/subtitle/servicesSection/cta; the middle
   block varies by discipline, so the page renders whichever ones exist. */
const blockKeys = [
  'servicesSection',
  'threePillars',
  'corePrinciples',
  'techStack',
  'expertise',
  'hypervisors',
  'platforms',
  'platformSupport',
  'valueProposition',
  'targetAudience',
  'whyChooseUs',
];

const blocks = blockKeys
  .map((key) => getSection(locale, `${service.key}.${key}`))
  .filter((s): s is NonNullable<typeof s> => s !== null && (s.items.length > 0 || !!s.title));
---
<Base locale={locale} title={name} description={subtitle}>
  <Breadcrumb
    locale={locale}
    trail={[{ label: t('header.services'), href: lp('/services') }, { label: name }]}
  />

  <section class="section blueprint">
    <div class="shell svc-hero">
      <div class="svc-hero__mark"><Icon path={service.icon} size={22} /></div>
      <div class="badge badge--accent rise">{t(`${service.key}.badge`)}</div>
      <h1 class="display-xl rise" style="animation-delay:.12s">{title}</h1>
      <p class="lead svc-hero__lead rise" style="animation-delay:.24s">{subtitle}</p>
      <div class="svc-hero__actions rise" style="animation-delay:.34s">
        <a href={lp('/contact')} class="btn btn--primary">{t(`${service.key}.buttons.getStarted`)}<Arrow /></a>
        <a href={lp('/contact')} class="btn btn--ghost">{t(`${service.key}.buttons.contactUs`)}</a>
      </div>
    </div>
  </section>

  {blocks.map((section, i) => (
    <ContentBlock section={section} cols={3} alt={i % 2 === 0} />
  ))}

  <CallToAction
    title={t(`${service.key}.cta.title`)}
    description={t(`${service.key}.cta.description`)}
    primary={{ label: t(`${service.key}.cta.primaryButton`), href: lp('/contact') }}
    secondary={{ label: t('header.services'), href: lp('/services') }}
  />
</Base>

<style>
  .svc-hero { display: flex; flex-direction: column; gap: 24px; max-width: 900px; }
  .svc-hero__mark {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border: 1px solid var(--accent-edge);
    background: var(--accent-wash);
    color: var(--accent);
  }
  .svc-hero__lead { max-width: 700px; font-size: clamp(16px, 1.4vw, 19px); }
  .svc-hero__actions { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
  @media (max-width: 700px) { .svc-hero__actions .btn { width: 100%; } }
</style>
