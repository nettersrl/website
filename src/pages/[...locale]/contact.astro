---
import Base from '../../layouts/Base.astro';
import ContactForm from '../../components/ContactForm.tsx';
import { company, contactForm } from '../../data/site';
import { useTranslations, localeParams, type Locale } from '../../i18n/ui';

export function getStaticPaths() {
  return localeParams();
}

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);

const labels = {
  email: t('contact.emailLabel'),
  emailPlaceholder: t('contact.emailPlaceholder'),
  message: t('contact.messageLabel'),
  messagePlaceholder: t('contact.messagePlaceholder'),
  submit: t('contact.submit'),
  submitting: t('contact.submitting'),
  successTitle: t('contact.successTitle'),
  successMessage: t('contact.successMessage'),
  captchaRequired: 'Please complete the verification below.',
  failed: 'There was a problem sending your message. Please try again.',
};
---
<Base locale={locale} title={t('contact.title')} description={t('contact.subtitle')}>
  <!-- reCAPTCHA loads only here, not site-wide as it did before. -->
  <script slot="head" src="https://www.google.com/recaptcha/api.js" async defer is:inline></script>

  <section class="section blueprint">
    <div class="shell contact">
      <div class="contact__copy">
        <div class="badge rise">{t('contact.badge')}</div>
        <h1 class="display-xl rise" style="animation-delay:.14s">{t('contact.title')}</h1>
        <p class="lead rise" style="animation-delay:.26s">{t('contact.subtitle')}</p>

        <div class="contact__cards rise" style="animation-delay:.36s">
          <div class="ccard">
            <div class="ccard__label mono">{t('contact.info.email.title')}</div>
            <a href={`mailto:${company.email}`} class="ccard__value">{company.email}</a>
            <p class="body-muted">{t('contact.info.email.description')}</p>
          </div>
          <div class="ccard">
            <div class="ccard__label mono">{company.name}</div>
            <address class="ccard__address">{company.street}<br />{company.city}</address>
            <p class="mono ccard__vat">{t('footer.company.vat')}</p>
          </div>
        </div>
      </div>

      <div class="contact__form">
        <h2 class="contact__form-title">{t('contact.formTitle')}</h2>
        <ContactForm
          client:load
          endpoint={contactForm.endpoint}
          siteKey={contactForm.recaptchaSiteKey}
          labels={labels}
        />
        <noscript>
          <p class="contact__noscript">
            This form needs JavaScript. Email us directly at
            <a href={`mailto:${company.email}`}>{company.email}</a>.
          </p>
        </noscript>
      </div>
    </div>
  </section>
</Base>

<style>
  .contact { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 64px; align-items: start; }
  .contact__copy { display: flex; flex-direction: column; gap: 24px; }
  .contact__cards { display: flex; flex-direction: column; gap: 1px; background: var(--hairline); border: 1px solid var(--hairline); margin-top: 12px; }
  .ccard { display: flex; flex-direction: column; gap: 8px; padding: 26px 24px; background: var(--surface); }
  .ccard__label { font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-faint); }
  .ccard__value { font-family: var(--font-display); font-size: 20px; font-weight: 600; letter-spacing: -0.015em; color: var(--accent); }
  .ccard__address { font-style: normal; font-size: 15px; line-height: 1.65; color: var(--ink); }
  .ccard__vat { font-size: 12px; color: var(--ink-faint); }

  .contact__form { padding: 40px 36px; border: 1px solid var(--hairline); background: var(--surface); }
  .contact__form-title { font-family: var(--font-display); font-size: 24px; font-weight: 600; letter-spacing: -0.02em; margin-bottom: 26px; }
  .contact__noscript { margin-top: 16px; font-size: 14px; color: var(--ink-muted); }

  @media (max-width: 960px) {
    .contact { grid-template-columns: minmax(0, 1fr); gap: 40px; }
    .contact__form { padding: 28px 22px; }
  }
</style>

<style is:global>
  .form { display: flex; flex-direction: column; gap: 22px; }
  .form__field { display: flex; flex-direction: column; gap: 9px; }
  .form__label { font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-faint); }
  .form__input {
    width: 100%;
    min-height: 52px;
    padding: 14px 16px;
    background: var(--ground);
    border: 1px solid var(--border);
    color: var(--ink);
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 1.5;
    transition: border-color 0.25s ease;
  }
  .form__input::placeholder { color: var(--ink-ghost); }
  .form__input:focus { outline: none; border-color: var(--accent); }
  .form__input--area { resize: vertical; min-height: 150px; }
  .form__trap { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
  .form__captcha { min-height: 78px; }
  .form__error { font-size: 14px; color: var(--accent); }
  .form__submit { width: 100%; }
  .form__submit:disabled { opacity: 0.6; cursor: not-allowed; }

  .form--done { align-items: flex-start; gap: 14px; padding: 18px 0; }
  .form__done-title { font-family: var(--font-display); font-size: 22px; font-weight: 600; letter-spacing: -0.02em; }
</style>
