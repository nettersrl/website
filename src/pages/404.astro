---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import { useTranslations, localizePath, defaultLocale } from '../i18n/ui';

const locale = defaultLocale;
const t = useTranslations(locale);
const lp = (p: string) => localizePath(p, locale);
---
<Base locale={locale} title="Page not found" description="That page does not exist." noindex>
  <section class="section blueprint nf">
    <div class="shell nf__inner">
      <div class="mono nf__code">404</div>
      <h1 class="display-xl">This page doesn't exist.</h1>
      <p class="lead nf__lead">
        The link may be out of date. Everything below is a good place to pick up again.
      </p>
      <div class="nf__links">
        <a href={lp('/')} class="btn btn--primary">{t('header.home')}<Arrow /></a>
        <a href={lp('/products')} class="btn btn--ghost">{t('header.products')}</a>
        <a href={lp('/services')} class="btn btn--ghost">{t('header.services')}</a>
        <a href={lp('/contact')} class="btn btn--ghost">{t('common.contactUs')}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf { min-height: 64vh; display: flex; align-items: center; }
  .nf__inner { display: flex; flex-direction: column; gap: 24px; max-width: 760px; }
  .nf__code { font-size: 12px; letter-spacing: 0.3em; color: var(--accent); }
  .nf__lead { max-width: 520px; }
  .nf__links { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 8px; }
</style>
