---
import { t } from '../lib/copy';

interface Crumb { label: string; href?: string }
interface Props { trail: Crumb[] }
const { trail } = Astro.props;
---
<nav class="crumbs mono" aria-label="Breadcrumb">
  <div class="shell crumbs__inner">
    <a href="/">{t('header.home')}</a>
    {trail.map((c) => (
      <>
        <span class="crumbs__sep" aria-hidden="true">/</span>
        {c.href ? <a href={c.href}>{c.label}</a> : <span class="crumbs__current" aria-current="page">{c.label}</span>}
      </>
    ))}
  </div>
</nav>

<style>
  .crumbs { border-bottom: 1px solid var(--hairline); }
  .crumbs__inner {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    padding-block: 18px;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .crumbs__inner a { color: var(--ink-faint); }
  .crumbs__inner a:hover { color: var(--accent); }
  .crumbs__sep { color: var(--ink-ghost); }
  .crumbs__current { color: var(--ink); }
</style>
