---
import Logo from './Logo.astro';
import EmailLink from './EmailLink.astro';
import { products, services, company, productHref } from '../data/site';
import { t } from '../lib/copy';

const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="shell">
    <div class="footer__brand">
      <Logo height={26} />
      <p class="footer__motto">{t('footer.tagline')}</p>
    </div>

    <div class="footer__grid">
      <nav class="footer__col" aria-labelledby="f-products">
        <div id="f-products" class="footer__label mono">{t('header.products')}</div>
        {products.map((p) => (
          <a
            href={productHref(p, (path) => path)}
            rel={p.url ? 'noopener' : undefined}
            target={p.url ? '_blank' : undefined}
          >{t(`${p.key}.name`)}</a>
        ))}
      </nav>

      <nav class="footer__col" aria-labelledby="f-services">
        <div id="f-services" class="footer__label mono">{t('header.services')}</div>
        {services.slice(0, 5).map((s) => (
          <a href={`/services/${s.slug}`}>{t(`${s.key}.name`)}</a>
        ))}
        <a href="/services">{t('common.viewDetails')}</a>
      </nav>

      <nav class="footer__col" aria-labelledby="f-company">
        <div id="f-company" class="footer__label mono">Company</div>
        <a href="/about">{t('header.about')}</a>
        <a href="/products">{t('header.products')}</a>
        <EmailLink label={t('common.contactUs')} />
      </nav>

      <div class="footer__col">
        <div class="footer__label mono">{company.name}</div>
        <address class="footer__address">
          {company.street}<br />{company.city}
        </address>
        <div class="footer__vat mono">{t('footer.company.vat')}</div>
      </div>
    </div>

    <div class="footer__base">
      <div class="mono footer__legal">
        © {year} {company.name.toUpperCase()} — {t('common.allRightsReserved').toUpperCase()}
      </div>
      <p class="footer__trademarks">
        All registered trademarks used on this site are the property of their respective owners.
      </p>
    </div>
  </div>
</footer>

<style>
  .footer { padding-block: 64px 40px; background: var(--ground); }

  /* Brand lockup: logo and motto share one left edge, above the link columns. */
  .footer__brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    padding-bottom: 44px;
    border-bottom: 1px solid var(--hairline);
  }
  .footer__motto {
    font-family: var(--font-display);
    font-size: clamp(20px, 2.2vw, 28px);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.15;
    color: var(--ink);
    max-width: 18ch;
  }

  .footer__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 40px;
    padding-block: 44px;
    border-bottom: 1px solid var(--hairline);
  }
  .footer__col { display: flex; flex-direction: column; align-items: flex-start; gap: 14px; }
  .footer__col a { font-size: 14px; color: var(--ink-muted); }
  .footer__col a:hover { color: var(--accent); }
  .footer__label {
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .footer__address { font-style: normal; font-size: 14px; line-height: 1.7; color: var(--ink-dim); }
  .footer__vat { font-size: 12px; color: var(--ink-faint); margin-top: 4px; }

  .footer__base {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
    padding-top: 26px;
  }
  .footer__legal { font-size: 11px; letter-spacing: 0.06em; color: var(--ink-ghost); }
  .footer__trademarks { font-size: 11px; line-height: 1.6; color: var(--ink-ghost); max-width: 54ch; }

  @media (max-width: 900px) {
    .footer__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px; }
  }
  @media (max-width: 560px) {
    .footer__grid { grid-template-columns: minmax(0, 1fr); }
  }
</style>
