---
interface Props { path: string; size?: number; class?: string }
const { path, size = 16, class: className = '' } = Astro.props;
---
<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="square"
  stroke-linejoin="miter"
  class={className}
  aria-hidden="true"
><path d={path} /></svg>
