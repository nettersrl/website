---
import { plane, planeGrid, cube, project, type Camera } from '../lib/iso';

interface Props {
  layers: [string, string, string];
  nodes: string[];
  compact?: boolean;
}
const { layers, nodes, compact = false } = Astro.props;

const u = compact ? 17 : 28;
const cam: Camera = compact ? { u, x: 158, y: 186 } : { u, x: 272, y: 310 };
const size = compact ? { w: 350, h: 300 } : { w: 600, h: 500 };
const lifts = compact ? { top: 158, mid: 86, bot: 14 } : { top: 260, mid: 140, bot: 20 };
const nodeH = compact ? 19 : 30;
const meshH = compact ? 9 : 14;
const W = 7, D = 5;

const planes = [
  { lift: lifts.bot, label: layers[2], fill: 'rgba(20,20,26,.78)', stroke: '#24242c', grid: '#17171e', ink: '#44444e' },
  { lift: lifts.mid, label: layers[1], fill: 'rgba(24,24,31,.78)', stroke: '#2c2c36', grid: '#1c1c24', ink: '#5c5c66' },
  { lift: lifts.top, label: layers[0], fill: 'rgba(30,12,15,.45)', stroke: '#e3000f', grid: '#3a1015', ink: '#e3000f' },
].map((p) => {
  const anchor = project(0, D, cam, p.lift);
  return {
    ...p,
    face: plane(0, 0, W, D, cam, p.lift),
    rules: planeGrid(0, 0, W, D, cam, p.lift, 1),
    labelX: anchor[0] - (compact ? 30 : 46),
    labelY: anchor[1] + (compact ? 14 : 18),
  };
});

const slots = [
  { gx: 0.55, gy: 0.55 },
  { gx: 3.55, gy: 0.55 },
  { gx: 0.55, gy: 2.75 },
  { gx: 3.55, gy: 2.75 },
];
/* Painter's algorithm: an isometric scene must draw back-to-front, and
   depth on this camera is simply gx + gy. */
const productNodes = nodes
  .slice(0, 4)
  .map((label, i) => {
    const s = slots[i]!;
    return { ...cube(s.gx, s.gy, 1.55, nodeH, cam, lifts.top), label, depth: s.gx + s.gy };
  })
  .sort((a, b) => a.depth - b.depth);

const mesh: ReturnType<typeof cube>[] = [];
for (let i = 0; i < 3; i++) {
  for (let j = 0; j < 2; j++) {
    mesh.push(cube(0.8 + i * 2.1, 1.0 + j * 2.0, 0.8, meshH, cam, lifts.mid));
  }
}
mesh.sort((a, b) => a.cy - b.cy);

const links = productNodes.map((n) => ({
  x: n.bx,
  y1: n.by,
  y2: n.by + (lifts.top - lifts.bot),
}));
---
<div class="iso-float iso-stack">
  <svg
    viewBox={`0 0 ${size.w} ${size.h}`}
    width={size.w}
    height={size.h}
    fill="none"
    role="img"
    aria-label={`${layers[0]} running on ${layers[1]}, running on ${layers[2]}`}
  >
    {planes.map((p) => (
      <g>
        <polygon points={p.face} fill={p.fill} stroke={p.stroke} stroke-width="1" />
        {p.rules.map((l) => (
          <line x1={l.x1} y1={l.y1} x2={l.x2} y2={l.y2} stroke={p.grid} stroke-width="1" />
        ))}
        <text
          x={p.labelX} y={p.labelY} fill={p.ink}
          font-size={compact ? 9 : 11} letter-spacing={compact ? 1.2 : 1.6}
          font-family="var(--font-mono)"
        >{p.label.toUpperCase()}</text>
      </g>
    ))}

    {links.map((l) => (
      <line class="flow" x1={l.x} y1={l.y1} x2={l.x} y2={l.y2} stroke="#3a3a46" stroke-width="1" />
    ))}

    {mesh.map((m) => (
      <g>
        <polygon points={m.left} fill="rgba(24,24,31,.9)" />
        <polygon points={m.right} fill="rgba(16,16,22,.9)" />
        <polygon points={m.top} fill="rgba(58,58,70,.55)" stroke="#4a4a58" stroke-width="1" />
      </g>
    ))}

    {productNodes.map((n) => (
      <g>
        <polygon points={n.left} fill="rgba(120,8,18,.5)" />
        <polygon points={n.right} fill="rgba(70,6,12,.55)" />
        <polygon points={n.top} fill="rgba(227,0,15,.16)" stroke="#e3000f" stroke-width="1" />
        <text
          x={n.cx} y={n.cy + (compact ? 3 : 4)} fill="#f5f5f7"
          font-size={compact ? 9 : 12} font-weight="600" text-anchor="middle"
          font-family="var(--font-display)"
        >{n.label}</text>
      </g>
    ))}
  </svg>
</div>

<style>
  .iso-stack { display: flex; justify-content: center; }
  .iso-stack svg { max-width: 100%; height: auto; overflow: visible; }
</style>
