---
import Logo from './Logo.astro';
import SiteNav from './SiteNav.tsx';
import { products, services, productHref } from '../data/site';
import { t } from '../lib/copy';

const groups = [
  {
    label: t('header.products'),
    items: products.map((p) => ({
      label: t(`${p.key}.name`),
      href: productHref(p, (path) => path),
      description: t(`${p.key}.description`),
      external: Boolean(p.url),
      status: p.status,
    })),
  },
  {
    label: t('header.services'),
    items: services.map((s) => ({
      label: t(`${s.key}.name`),
      href: `/services/${s.slug}`,
      description: t(`${s.key}.description`),
      external: false,
    })),
  },
];

const links = [{ label: t('header.about'), href: '/about' }];
---
<header class="header">
  <div class="header__inner">
    <a href="/" class="header__brand" aria-label="Netter — home">
      <Logo height={26} />
    </a>
    <SiteNav
      client:load
      groups={groups}
      links={links}
      cta={{ label: t('common.contactUs') }}
      menuLabel="Open menu"
      closeLabel="Close menu"
      currentPath={Astro.url.pathname}
    />
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgba(7, 7, 10, 0.88);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--hairline);
  }
  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 52px;
    height: var(--header-h);
    max-width: var(--maxw);
    margin: 0 auto;
    padding-inline: var(--gutter);
  }
  .header__brand { flex-shrink: 0; }
</style>

<style is:global>
  .nav { display: contents; }

  .nav__desktop { display: flex; align-items: center; gap: 34px; margin-right: auto; }
  .nav__group { position: relative; }

  .nav__trigger,
  .nav__link {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    height: var(--header-h);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.01em;
    color: var(--ink);
    background: none;
    border: 0;
    transition: color 0.25s ease;
  }
  .nav__trigger:hover, .nav__link:hover { color: var(--accent); }
  .nav__link[aria-current='page'] { color: var(--accent); }

  .nav__panel {
    position: absolute;
    top: var(--header-h);
    left: -20px;
    z-index: 50;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    width: 620px;
    background: var(--hairline);
    border: 1px solid var(--border);
    box-shadow: 0 24px 48px -12px rgba(0, 0, 0, 0.7);
    animation: rise-in 0.2s var(--ease) both;
  }
  .nav__card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 18px 20px;
    background: var(--surface);
    border-top: 2px solid transparent;
    transition: border-color 0.2s ease, background 0.2s ease;
  }
  .nav__card:hover { border-top-color: var(--accent); background: var(--raised); color: var(--ink); }
  .nav__card-title {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .nav__card:hover .nav__card-title { color: var(--accent); }
  .nav__card-desc { font-size: 12.5px; line-height: 1.5; color: var(--ink-dim); }
  .nav__plate {
    display: inline-flex;
    align-items: center;
    padding: 3px 7px;
    border: 1px solid var(--accent-edge);
    background: var(--accent-wash);
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    line-height: 1;
  }
  .nav__drawer-name { display: inline-flex; align-items: center; gap: 10px; }

  .nav__rail { display: flex; align-items: center; gap: 22px; flex-shrink: 0; }

  .nav__burger {
    display: none;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    border: 1px solid var(--hairline);
    color: var(--ink);
  }

  /* The header's backdrop-filter makes it a containing block, so a fixed
     drawer would resolve against the header box (and collapse). Position it
     against the header explicitly instead. */
  .nav__drawer {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    height: calc(100dvh - var(--header-h));
    z-index: 45;
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding: 28px var(--gutter) 48px;
    background: var(--ground);
    overflow-y: auto;
    animation: rise-in 0.25s var(--ease) both;
  }
  .nav__drawer-group { display: flex; flex-direction: column; gap: 1px; background: var(--hairline); border: 1px solid var(--hairline); }
  .nav__drawer-label {
    padding: 12px 18px;
    background: var(--ground-alt);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .nav__drawer-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 56px;
    padding: 14px 18px;
    background: var(--surface);
    font-size: 15px;
    font-weight: 600;
  }
  .nav__drawer-cta { width: 100%; }

  @media (max-width: 1100px) {
    .nav__panel { width: 520px; }
  }
  @media (max-width: 900px) {
    .nav__desktop, .nav__cta { display: none; }
    .nav__burger { display: inline-flex; }
    .nav__rail { margin-left: auto; gap: 10px; }
  }
  @media (min-width: 901px) {
    .nav__drawer { display: none; }
  }
</style>
